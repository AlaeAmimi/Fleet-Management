{
  "name": "fleet-management",
  "version": "1.0.0",
  "description": "Fleet management REST API",
  "main": "src/server.js",
  "scripts": {
  "start": "node src/server.js",
  "dev": "nodemon src/server.js",
  "seed:admin": "node src/seeds/createAdmin.js",
  "test": "jest --runInBand",
  "coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js", "!src/seeds/**"],
    "coverageThreshold": {
      "global": { "branches": 70, "functions": 70, "lines": 70, "statements": 70 }
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-slow-down": "^3.1.1",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "pdfkit": "^0.20.2",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
